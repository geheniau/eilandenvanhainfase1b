# URL van de AM PIM MCP server (streamable HTTP)
PIM_MCP_URL=REDACTED-PIM-MCP-URL

# Bearer token voor de PIM MCP (header "Authorization: Bearer <token>").
# Nooit committen: kopieer dit bestand naar .env.local en vul in.
PIM_MCP_TOKEN=

# PIM project-id van het projectwebsite (Eilanden van Hain - Fase 1B = 1409)
PIM_PROJECT_ID=1409
